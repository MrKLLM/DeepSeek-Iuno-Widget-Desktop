{
  "name": "dsh-iuno-widget-desktop",
  "version": "1.23.0",
  "description": "DeepSeek Harness 桌面端（Electron）尤诺整站皮肤 —— 静态壁纸 / 侧栏「尤诺主题」设置页 / 开场欢迎字 + 首帧线稿横向扫描 + 水纹粒子 / 抽卡片尾循环壁纸 / 金色发丝线 / 桌宠 / 鼠标流光",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-desktop",
    "desktop",
    "electron",
    "theme",
    "skin",
    "iuno",
    "intro",
    "startup",
    "wallpaper",
    "settings"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "license": "MIT"
}
